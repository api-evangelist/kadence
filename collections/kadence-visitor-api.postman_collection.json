          "name": "Get visitors",
          "request": {
            "name": "Get visitors",
            "description": {
              "content": "Get a deduplicated directory of everyone who has visited your company as a guest.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "public",
                "visitors"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
